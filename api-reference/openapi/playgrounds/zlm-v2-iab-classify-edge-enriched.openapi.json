              {
                "type": "object"
              },
              {
                "type": "array",
                "items": {}
              }
            ]
          },
          "questions": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 16,
            "description": "Named questions (up to 16). Keys are names you choose; each answer comes back under the same key.",
