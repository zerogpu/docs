    "/systemone": {
      "post": {
        "operationId": "createSystemOneDecision",
        "summary": "Create System One decision",
        "description": "Answer named `noul`, `choice` and `score` questions about `state`, compatible with TypeSafe System One.",
        "tags": [
          "System One"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SystemOneRequest"
              },
              "example": {
                "model": "zlm-v2-iab-classify-edge-enriched",
                "state": "Apple announced a new MacBook powered by its latest M-series processor. Preorders open today.",
                "questions": {
                  "category": {
                    "type": "choice",
                    "instructions": "Which category best describes this content?",
                    "criteria": {
                      "technology": "Technology and computing",
                      "finance": "Personal finance",
                      "travel": "Travel"
                    }
                  },
                  "brand_safe": {
                    "type": "noul",
                    "instructions": "Is this content suitable for brand advertising?"
                  },
                  "commercial_intent": {
                    "type": "score",
                    "instructions": "How strong is the commercial intent?",
                    "criteria": [
                      "None",
                      "Low",
                      "Medium",
                      "High"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemOneResponse"
                },
                "example": {
                  "model": "zlm-v2-iab-classify-edge-enriched",
                  "answers": {
                    "category": {
                      "type": "choice",
                      "choice": "technology",
                      "confidence": 0.95,
                      "probabilities": {
                        "technology": 0.95,
                        "finance": 0.03,
                        "travel": 0.02
                      }
                    },
                    "brand_safe": {
                      "type": "noul",
                      "noul": 0.98
                    },
                    "commercial_intent": {
                      "type": "score",
                      "score": 2.64,
                      "confidence": 0.7,
                      "legend": {
                        "0": "None",
                        "1": "Low",
                        "2": "Medium",
                        "3": "High"
                      },
                      "probabilities": {
                        "0": 0.01,
                        "1": 0.04,
                        "2": 0.25,
                        "3": 0.7
                      }
                    }
                  },
                  "usage": {
                    "input_tokens": 120,
                    "output_tokens": 0,
                    "total_tokens": 120
                  }
                }
              }
            }
          },
          "400": {
            "description": "The model does not support System One (`model_not_supported`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (invalid or missing API key)"
          },
          "402": {
            "description": "Insufficient quota (insufficient_quota)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Model not found (`model_not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
