          "type": {
            "type": "string",
            "const": "score"
          },
          "score": {
            "type": "number",
            "description": "Probability-weighted average level; may fall between integers."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "legend": {
            "type": "object",
            "description": "Level key (\"0\", \"1\", ...) to its criteria text.",
            "additionalProperties": {}
          },
          "probabilities": {
            "type": "object",
            "description": "Keyed like `legend`; sums to about 1.",
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      },
      "SystemOneUsage": {
        "type": "object",
        "required": [
          "input_tokens",
          "output_tokens",
          "total_tokens"
        ],
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Tokens billed: the state plus the questions."
          },
          "output_tokens": {
            "type": "integer",
            "description": "Always 0; System One output is not billed."
          },
          "total_tokens": {
            "type": "integer"
          }
        }
      },
      "HTTPValidationError": {
        "type": "object",
        "description": "Request validation failure (System One's own error shape).",
        "properties": {
          "detail": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "loc",
                "msg",
                "type"
              ],
              "properties": {
                "loc": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  }
                },
                "msg": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
