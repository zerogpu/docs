        "properties": {
          "model": {
            "type": "string",
            "description": "A model that supports System One: `zlm-v1-moderation-edge`, `zlm-v1-iab-classify-edge`, `zlm-v1-iab-domain-classifier` or `zlm-v2-iab-classify-edge-enriched`.",
            "example": "zlm-v1-iab-classify-edge"
          },
          "state": {
            "description": "The content every question refers to: a string, object or array. An object or array is read as its JSON. For `zlm-v1-iab-domain-classifier` it must be a URL or domain.",
