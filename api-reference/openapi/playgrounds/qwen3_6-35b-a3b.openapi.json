                        "example": "qwen3.6-35b-a3b",
                        "description": "Model identifier (fixed for this playground). Use request examples to change use cases."
                      }
                    }
                  }
                ]
              },
              "examples": {
                "image_qa": {
                  "summary": "Image analysis",
                  "value": {
                    "input": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "input_image",
                            "detail": "auto",
                            "image_url": "https://upload.wikimedia.org/wikipedia/commons/3/3a/Cat03.jpg"
                          },
                          {
                            "text": "What animal is this, and what is it doing?",
                            "type": "input_text"
                          }
                        ]
                      }
                    ],
                    "model": "qwen3.6-35b-a3b",
                    "temperature": 0.2,
                    "max_output_tokens": 512
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
