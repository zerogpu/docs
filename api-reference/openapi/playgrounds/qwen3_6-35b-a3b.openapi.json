          "qwen3.6-35b-a3b"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/CreateChatCompletionRequest"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "model": {
                        "type": "string",
                        "const": "qwen3.6-35b-a3b",
                        "default": "qwen3.6-35b-a3b",
                        "example": "qwen3.6-35b-a3b",
                        "description": "Model identifier (fixed for this playground). Use request examples to change use cases."
                      }
                    }
                  }
                ]
              },
              "examples": {
                "video_and_image": {
                  "summary": "Video and image analysis",
                  "value": {
                    "model": "qwen3.6-35b-a3b",
                    "messages": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "video_url",
                            "video_url": {
                              "url": "https://qianwen-res.oss-accelerate.aliyuncs.com/Qwen3.5/demo/video/N1cdUjctpG8.mp4"
                            }
                          },
                          {
                            "type": "image_url",
                            "image_url": {
                              "url": "https://upload.wikimedia.org/wikipedia/commons/3/3a/Cat03.jpg",
                              "detail": "auto"
                            }
                          },
                          {
                            "text": "Describe what happens in the video, then say whether the animal in the photo appears in it.",
                            "type": "text"
                          }
                        ]
                      }
                    ],
                    "max_tokens": 512,
                    "temperature": 0.2
                  }
                }
              }
            }
