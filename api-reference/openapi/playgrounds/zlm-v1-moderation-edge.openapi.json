              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "criteria": {
            "description": "Optional definitions of what counts as true and false.",
            "anyOf": [
              {
                "type": "object",
                "properties": {
