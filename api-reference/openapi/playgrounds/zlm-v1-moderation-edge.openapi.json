                  "type": "string"
                },
                {
                  "type": "object"
                },
                {
                  "type": "array",
                  "items": {}
                }
              ]
            }
          }
        }
      },
      "SystemOneResponse": {
        "type": "object",
        "required": [
          "model",
          "answers",
          "usage"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "The model that answered."
          },
          "answers": {
            "type": "object",
            "description": "Keyed by your question names, in request order.",
            "additionalProperties": {
              "$ref": "#/components/schemas/SystemOneAnswer"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/SystemOneUsage"
          }
        }
      },
      "SystemOneAnswer": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/NoulAnswer"
          },
          {
            "$ref": "#/components/schemas/ChoiceAnswer"
          },
          {
            "$ref": "#/components/schemas/ScoreAnswer"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "noul": "#/components/schemas/NoulAnswer",
            "choice": "#/components/schemas/ChoiceAnswer",
            "score": "#/components/schemas/ScoreAnswer"
          }
        }
      },
      "NoulAnswer": {
        "type": "object",
        "required": [
          "type",
          "noul"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "noul"
          },
          "noul": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Probability of true. Near 1 favors true, near 0 favors false, near 0.5 is uncertain."
          }
        }
      },
      "ChoiceAnswer": {
        "type": "object",
        "required": [
          "type",
          "choice",
          "confidence",
          "probabilities"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "choice"
          },
          "choice": {
            "type": "string",
            "description": "The most likely choice name."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "probabilities": {
            "type": "object",
            "description": "Keyed by choice name; sums to about 1.",
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      },
      "ScoreAnswer": {
        "type": "object",
        "required": [
          "type",
          "score",
          "confidence",
          "legend",
          "probabilities"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "score"
          },
          "score": {
            "type": "number",
            "description": "Probability-weighted average level; may fall between integers."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "legend": {
            "type": "object",
            "description": "Level key (\"0\", \"1\", ...) to its criteria text.",
            "additionalProperties": {}
          },
          "probabilities": {
            "type": "object",
            "description": "Keyed like `legend`; sums to about 1.",
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      },
      "SystemOneUsage": {
        "type": "object",
        "required": [
          "input_tokens",
          "output_tokens",
          "total_tokens"
        ],
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Tokens billed: the state plus the questions."
          },
          "output_tokens": {
            "type": "integer",
            "description": "Always 0; System One output is not billed."
          },
          "total_tokens": {
            "type": "integer"
          }
        }
      },
      "HTTPValidationError": {
        "type": "object",
        "description": "Request validation failure (System One's own error shape).",
        "properties": {
          "detail": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "loc",
                "msg",
                "type"
              ],
              "properties": {
                "loc": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  }
                },
                "msg": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
