      "NoulQuestion": {
        "type": "object",
        "required": [
          "type"
        ],
        "description": "A yes/no (true/false) decision.",
        "properties": {
          "type": {
            "type": "string",
            "const": "noul"
          },
          "instructions": {
            "description": "The statement or question to evaluate.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "criteria": {
            "description": "Optional definitions of what counts as true and false.",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "true": {
                    "description": "Free-form text: a string, or an object or array that is read as its JSON.",
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object"
                      },
                      {
                        "type": "array",
                        "items": {}
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "false": {
                    "description": "Free-form text: a string, or an object or array that is read as its JSON.",
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object"
                      },
                      {
                        "type": "array",
                        "items": {}
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ChoiceQuestion": {
        "type": "object",
        "required": [
          "type",
          "criteria"
        ],
        "description": "Pick one option.",
        "properties": {
          "type": {
            "type": "string",
            "const": "choice"
          },
          "instructions": {
            "description": "Free-form text: a string, or an object or array that is read as its JSON.",
            "anyOf": [
