            ]
          },
          "criteria": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 32,
            "description": "Choice names mapped to descriptions. A null description means the name alone is used.",
            "additionalProperties": {
              "description": "Free-form text: a string, or an object or array that is read as its JSON.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object"
                },
                {
                  "type": "array",
                  "items": {}
                },
