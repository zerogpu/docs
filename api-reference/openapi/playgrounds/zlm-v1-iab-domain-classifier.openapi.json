    "/systemone": {
      "post": {
        "operationId": "createSystemOneDecision",
        "summary": "Create System One decision",
        "description": "Answer named `noul`, `choice` and `score` questions about `state`, compatible with TypeSafe System One.",
        "tags": [
          "System One"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SystemOneRequest"
              },
              "example": {
                "model": "zlm-v1-iab-domain-classifier",
                "state": "https://www.espn.com",
                "questions": {
                  "category": {
                    "type": "choice",
                    "instructions": "Which category best describes this domain?",
                    "criteria": {
                      "sports": "Sports",
                      "news": "News and Politics",
                      "technology": "Technology & Computing"
                    }
                  },
                  "is_sports": {
                    "type": "noul",
                    "instructions": "Does this domain belong to category Sports?"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemOneResponse"
                },
                "example": {
                  "model": "zlm-v1-iab-domain-classifier",
                  "answers": {
                    "category": {
                      "type": "choice",
                      "choice": "sports",
                      "confidence": 0.99,
                      "probabilities": {
                        "sports": 0.99,
                        "news": 0.0,
                        "technology": 0.0
                      }
                    },
                    "is_sports": {
                      "type": "noul",
                      "noul": 0.998
                    }
                  },
                  "usage": {
                    "input_tokens": 54,
                    "output_tokens": 0,
                    "total_tokens": 54
                  }
                }
              }
            }
          },
          "400": {
            "description": "The model does not support System One (`model_not_supported`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (invalid or missing API key)"
          },
          "402": {
            "description": "Insufficient quota (insufficient_quota)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Model not found (`model_not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "502": {
            "description": "Upstream inference failed (`upstream_error`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
