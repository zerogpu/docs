{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ZeroGPU",
  "description": "ZeroGPU is the compute efficiency layer for AI inference. It runs repeatable, high-volume tasks - classification, extraction, PII redaction, moderation, summarization, routing - on specialized small and nano language models across an edge-powered network, faster and cheaper than centralized GPUs, through one OpenAI-compatible API. Edge Providers connect Android, Chrome, Telegram, desktop and server devices to the network and earn from the inference they serve.",
  "colors": {
    "primary": "#22C55E",
    "light": "#4ADE80",
    "dark": "#16A34A"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 500
    },
    "body": {
      "family": "Geist"
    }
  },
  "favicon": "/assets/favicon.ico",
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "params": {
      "expanded": "all"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript",
        "rust",
        "go",
        "ruby"
      ],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    },
    "mdx": {
      "server": "https://api.zerogpu.ai/v1"
    }
  },
